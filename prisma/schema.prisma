generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tenant {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())

  // relations (inverse fields)
  users             user[]
  brands            brand[]
  models            model[]
  customers         customer[]
  vehicles          vehicle[]
  parts             part[]
  services          servicecatalog[]
  workorders        workorder[]
  workorderparts    workorderpart[]
  workorderservices workorderservice[]

  paymentMethods    PaymentMethod[]
  financialAccounts FinancialAccount[]
  financialEntries  FinancialEntry[]
}

model brand {
  id      BigInt    @id @default(autoincrement())
  name    String
  model   model[]
  vehicle vehicle[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model customer {
  id              BigInt            @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  document        String?
  notes           String?
  customervehicle customervehicle[]
  workorder       workorder[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model model {
  id      BigInt    @id @default(autoincrement())
  name    String
  brandId BigInt
  brand   brand     @relation(fields: [brandId], references: [id])
  vehicle vehicle[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([brandId])
  @@index([tenantId])
}

model part {
  id            BigInt          @id @default(autoincrement())
  sku           String?
  name          String
  description   String?
  price         Decimal         @default(0)
  cost          Decimal         @default(0)
  stockQty      Int             @default(0)
  active        Boolean         @default(true)
  workorderpart workorderpart[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model payment {
  id          BigInt         @id @default(autoincrement())
  workOrderId BigInt
  paymentMethodId BigInt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount      Decimal
  installments Int?
  receivedAt  DateTime       @default(now())
  workorder   workorder      @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model servicecatalog {
  id                 BigInt             @id @default(autoincrement())
  name               String
  defaultPrice       Decimal            @default(0)
  defaultDurationMin Int?               @default(60)
  cost               Decimal            @default(0)
  active             Boolean            @default(true)
  description        String?
  workorderservice   workorderservice[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model user {
  id           BigInt   @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  tenantId BigInt? // null => user global/admin
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  // FK para tabela de roles (Role)
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  @@index([tenantId])
}

model vehicle {
  id    BigInt  @id @default(autoincrement())
  plate String
  year  Int?
  vin   String?
  color String?
  notes String?

  brandId BigInt?
  brand   brand?  @relation(fields: [brandId], references: [id])

  modelId BigInt?
  model   model?  @relation(fields: [modelId], references: [id])

  customervehicle customervehicle[]
  workorder       workorder[]

  imageUrl String? @db.VarChar(512)

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@index([modelId])
}

model customervehicle {
  customerId BigInt
  vehicleId  BigInt

  customer customer @relation(fields: [customerId], references: [id])
  vehicle  vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([customerId, vehicleId])
  @@index([vehicleId])
}

model workorder {
  id               BigInt             @id @default(autoincrement())
  number           String?
  customerId       BigInt
  vehicleId        BigInt
  status           workorder_status   @default(PENDING)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  notes            String?
  payment          payment[]
  customer         customer           @relation(fields: [customerId], references: [id])
  vehicle          vehicle            @relation(fields: [vehicleId], references: [id])
  workorderpart    workorderpart[]
  workorderservice workorderservice[]
  financialEntries FinancialEntry[]
  discount         Decimal @default(0) 

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([tenantId])
}

model workorderpart {
  id          BigInt    @id @default(autoincrement())
  workOrderId BigInt
  partId      BigInt
  qty         Decimal   @default(1)
  unitPrice   Decimal   @default(0)
  unitCost    Decimal   @default(0)
  discount    Decimal   @default(0)
  part        part      @relation(fields: [partId], references: [id])
  workorder   workorder @relation(fields: [workOrderId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([partId])
  @@index([workOrderId])
  @@index([tenantId])
}

model workorderservice {
  id             BigInt         @id @default(autoincrement())
  workOrderId    BigInt
  serviceId      BigInt
  qty            Decimal        @default(1)
  unitPrice      Decimal        @default(0)
  unitCost       Decimal        @default(0)
  discount       Decimal        @default(0)
  servicecatalog servicecatalog @relation(fields: [serviceId], references: [id])
  workorder      workorder      @relation(fields: [workOrderId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([serviceId])
  @@index([workOrderId])
  @@index([tenantId])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users user[]
}

enum workorder_status {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum user_role {
  ADMIN
  STAFF
}

model PaymentMethod {
  id          BigInt   @id @default(autoincrement())
  name        String
  type        payment_type
  active      Boolean  @default(true)
  allowInstallments Boolean @default(false)
  defaultInstallments Int? 
  feePercent  Decimal? @default(0)
  description String?

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  payments payment[]
  financialEntries FinancialEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum payment_type {
  CASH        // à vista
  CREDIT      // cartão crédito
  DEBIT       // cartão débito
  PIX
  BANK
  EXCHANGE    // permuta
  OTHER
}

model FinancialAccount {
  id        BigInt  @id @default(autoincrement())
  name      String
  type      account_type
  balance   Decimal @default(0)

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum account_type {
  CASHBOX
  BANK
  CREDIT_CARD
}

model FinancialEntry {
  id              BigInt  @id @default(autoincrement())
  type            entry_type
  description     String?
  amount          Decimal
  dueDate         DateTime
  paidAt          DateTime?

  workOrderId     BigInt?   // 👈 adicionar
  workorder       workorder? @relation(fields: [workOrderId], references: [id])

  paymentMethodId BigInt?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum entry_type {
  RECEIVABLE
  PAYABLE
}