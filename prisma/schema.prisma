generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tenant {
  id            BigInt   @id @default(autoincrement())
  name          String   @unique
  code          String?  @unique
  document      String?
  phone         String?
  email         String?
  address       String?
  logoUrl       String?  @db.VarChar(512)
  createdAt     DateTime @default(now())
  country       String   @default("BR")
  defaultLocale String   @default("pt-BR")

  // relations (inverse fields)
  users             user[]
  brands            brand[]
  models            model[]
  customers         customer[]
  vehicles          vehicle[]
  parts             part[]
  services          servicecatalog[]
  workorders        workorder[]
  workorderparts    workorderpart[]
  workorderservices workorderservice[]

  paymentMethods       PaymentMethod[]
  financialAccounts    FinancialAccount[]
  financialCategories  FinancialCategory[]
  financialEntries     FinancialEntry[]
  FinancialTransaction FinancialTransaction[]
  contactLeads         contactLead[]
  crmPipelines         CrmPipeline[]
  crmStages            CrmPipelineStage[]
  crmDeals             CrmDeal[]
  crmActivities        CrmActivity[]
  crmTasks             CrmTask[]
  estimates            Estimate[]
  estimateItems        EstimateItem[]
}

model contactLead {
  id          BigInt              @id @default(autoincrement())
  name        String
  companyName String?
  email       String
  phone       String?
  message     String              @db.Text
  sourceUrl   String?             @db.VarChar(512)
  sourcePage  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  status      contact_lead_status @default(NEW)
  score       Int                 @default(0)
  aiStatus    contact_lead_status?
  aiConfidence Float?
  aiReason    String?             @db.Text
  classificationSource String      @default("RULE")
  classificationModel  String?
  notes       String?             @db.Text
  ipAddress   String?             @db.VarChar(64)
  userAgent   String?             @db.VarChar(255)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenantId    BigInt?
  tenant      tenant?             @relation(fields: [tenantId], references: [id])
  crmDeals    CrmDeal[]
  crmActivities CrmActivity[]
  crmTasks    CrmTask[]

  @@index([status, createdAt])
  @@index([score])
  @@index([email])
  @@index([tenantId])
  @@map("contact_leads")
}

model brand {
  id      BigInt    @id @default(autoincrement())
  name    String
  model   model[]
  vehicle vehicle[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model customer {
  id              BigInt            @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  document        String?
  notes           String?
  customervehicle customervehicle[]
  workorder       workorder[]
  crmDeals        CrmDeal[]
  crmActivities   CrmActivity[]
  crmTasks        CrmTask[]
  estimates       Estimate[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model model {
  id      BigInt    @id @default(autoincrement())
  name    String
  brandId BigInt
  brand   brand     @relation(fields: [brandId], references: [id])
  vehicle vehicle[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([brandId])
  @@index([tenantId])
}

model part {
  id            BigInt          @id @default(autoincrement())
  sku           String?
  name          String
  description   String?
  price         Decimal         @default(0)
  cost          Decimal         @default(0)
  stockQty      Int             @default(0)
  active        Boolean         @default(true)
  workorderpart workorderpart[]
  estimateItems EstimateItem[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model payment {
  id              BigInt        @id @default(autoincrement())
  workOrderId     BigInt
  paymentMethodId BigInt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal
  installments    Int?
  receivedAt      DateTime      @default(now())
  workorder       workorder     @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
}

model servicecatalog {
  id                 BigInt             @id @default(autoincrement())
  name               String
  defaultPrice       Decimal            @default(0)
  defaultDurationMin Int?               @default(60)
  cost               Decimal            @default(0)
  active             Boolean            @default(true)
  description        String?
  workorderservice   workorderservice[]
  estimateItems      EstimateItem[]

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model user {
  id           BigInt   @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  locale       String   @default("pt-BR")

  tenantId BigInt? // null => user global/admin
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  // FK para tabela de roles (Role)
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])
  crmDeals      CrmDeal[]
  crmActivities CrmActivity[]
  crmTasks      CrmTask[]

  @@index([tenantId])
}

model vehicle {
  id    BigInt  @id @default(autoincrement())
  plate String
  year  Int?
  vin   String?
  color String?
  notes String?

  brandId BigInt?
  brand   brand?  @relation(fields: [brandId], references: [id])

  modelId BigInt?
  model   model?  @relation(fields: [modelId], references: [id])

  customervehicle customervehicle[]
  workorder       workorder[]
  estimates       Estimate[]

  imageUrl String? @db.VarChar(512)

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@index([modelId])
}

model customervehicle {
  customerId BigInt
  vehicleId  BigInt

  customer customer @relation(fields: [customerId], references: [id])
  vehicle  vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([customerId, vehicleId])
  @@index([vehicleId])
}

model workorder {
  id               BigInt             @id @default(autoincrement())
  number           String?
  customerId       BigInt
  vehicleId        BigInt?
  status           workorder_status   @default(PENDING)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  notes            String?
  payment          payment[]
  customer         customer           @relation(fields: [customerId], references: [id])
  vehicle          vehicle?           @relation(fields: [vehicleId], references: [id])
  workorderpart    workorderpart[]
  workorderservice workorderservice[]
  financialEntries FinancialEntry[]
  discount         Decimal            @default(0)

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([tenantId])
}

model Estimate {
  id          BigInt          @id @default(autoincrement())
  number      String?
  tenantId    BigInt?
  customerId  BigInt
  vehicleId   BigInt?
  status      estimate_status @default(DRAFT)
  title       String?
  notes       String?         @db.Text
  subtotal    Decimal         @default(0)
  discount    Decimal         @default(0)
  total       Decimal         @default(0)
  validUntil  DateTime?
  sentAt      DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant   tenant?  @relation(fields: [tenantId], references: [id])
  customer customer @relation(fields: [customerId], references: [id])
  vehicle  vehicle? @relation(fields: [vehicleId], references: [id])
  items    EstimateItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([sentAt])
  @@map("estimates")
}

model EstimateItem {
  id          BigInt             @id @default(autoincrement())
  estimateId  BigInt
  tenantId    BigInt?
  type        estimate_item_type
  serviceId   BigInt?
  partId      BigInt?
  description String
  qty         Decimal            @default(1)
  unitPrice   Decimal            @default(0)
  unitCost    Decimal            @default(0)
  discount    Decimal            @default(0)
  total       Decimal            @default(0)
  createdAt   DateTime           @default(now())

  estimate Estimate        @relation(fields: [estimateId], references: [id])
  tenant   tenant?         @relation(fields: [tenantId], references: [id])
  service  servicecatalog? @relation(fields: [serviceId], references: [id])
  part     part?           @relation(fields: [partId], references: [id])

  @@index([estimateId])
  @@index([tenantId])
  @@index([serviceId])
  @@index([partId])
  @@map("estimate_items")
}

model workorderpart {
  id          BigInt    @id @default(autoincrement())
  workOrderId BigInt
  partId      BigInt
  qty         Decimal   @default(1)
  unitPrice   Decimal   @default(0)
  unitCost    Decimal   @default(0)
  discount    Decimal   @default(0)
  part        part      @relation(fields: [partId], references: [id])
  workorder   workorder @relation(fields: [workOrderId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([partId])
  @@index([workOrderId])
  @@index([tenantId])
}

model workorderservice {
  id             BigInt         @id @default(autoincrement())
  workOrderId    BigInt
  serviceId      BigInt
  qty            Decimal        @default(1)
  unitPrice      Decimal        @default(0)
  unitCost       Decimal        @default(0)
  discount       Decimal        @default(0)
  servicecatalog servicecatalog @relation(fields: [serviceId], references: [id])
  workorder      workorder      @relation(fields: [workOrderId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([serviceId])
  @@index([workOrderId])
  @@index([tenantId])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users user[]
}

model CrmPipeline {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt?
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant tenant?            @relation(fields: [tenantId], references: [id])
  stages CrmPipelineStage[]
  deals  CrmDeal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt?
  pipelineId BigInt
  name       String
  order      Int      @default(0)
  color      String?  @db.VarChar(32)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   tenant?     @relation(fields: [tenantId], references: [id])
  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id])
  deals    CrmDeal[]

  @@index([tenantId])
  @@index([pipelineId])
  @@map("crm_pipeline_stages")
}

model CrmDeal {
  id              BigInt          @id @default(autoincrement())
  tenantId        BigInt?
  pipelineId      BigInt?
  stageId         BigInt?
  customerId      BigInt?
  leadId          BigInt?
  ownerUserId     BigInt?
  title           String
  value           Decimal         @default(0)
  status          crm_deal_status @default(OPEN)
  source          String?
  lostReason      String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     tenant?           @relation(fields: [tenantId], references: [id])
  pipeline   CrmPipeline?      @relation(fields: [pipelineId], references: [id])
  stage      CrmPipelineStage? @relation(fields: [stageId], references: [id])
  customer   customer?         @relation(fields: [customerId], references: [id])
  lead       contactLead?      @relation(fields: [leadId], references: [id])
  owner      user?             @relation(fields: [ownerUserId], references: [id])
  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([tenantId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([customerId])
  @@index([leadId])
  @@index([ownerUserId])
  @@index([status])
  @@map("crm_deals")
}

model CrmActivity {
  id          BigInt            @id @default(autoincrement())
  tenantId    BigInt?
  dealId      BigInt?
  customerId  BigInt?
  leadId      BigInt?
  userId      BigInt?
  type        crm_activity_type @default(NOTE)
  title       String
  description String?
  happenedAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant   tenant?      @relation(fields: [tenantId], references: [id])
  deal     CrmDeal?     @relation(fields: [dealId], references: [id])
  customer customer?    @relation(fields: [customerId], references: [id])
  lead     contactLead? @relation(fields: [leadId], references: [id])
  user     user?        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@index([customerId])
  @@index([leadId])
  @@index([userId])
  @@index([happenedAt])
  @@map("crm_activities")
}

model CrmTask {
  id           BigInt          @id @default(autoincrement())
  tenantId     BigInt?
  dealId       BigInt?
  customerId   BigInt?
  leadId       BigInt?
  assignedToId BigInt?
  title        String
  description  String?
  status       crm_task_status @default(OPEN)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant     tenant?      @relation(fields: [tenantId], references: [id])
  deal       CrmDeal?     @relation(fields: [dealId], references: [id])
  customer   customer?    @relation(fields: [customerId], references: [id])
  lead       contactLead? @relation(fields: [leadId], references: [id])
  assignedTo user?        @relation(fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@index([customerId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  @@map("crm_tasks")
}

enum workorder_status {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum estimate_status {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

enum estimate_item_type {
  SERVICE
  PART
  CUSTOM
}

enum user_role {
  ADMIN
  STAFF
}

model PaymentMethod {
  id                  BigInt       @id @default(autoincrement())
  name                String
  type                payment_type
  active              Boolean      @default(true)
  allowInstallments   Boolean      @default(false)
  defaultInstallments Int?
  feePercent          Decimal?     @default(0)
  description         String?

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  payments         payment[]
  financialEntries FinancialEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum payment_type {
  CASH // à vista
  CREDIT // cartão crédito
  DEBIT // cartão débito
  PIX
  BANK
  EXCHANGE // permuta
  OTHER
}

model FinancialAccount {
  id      BigInt       @id @default(autoincrement())
  name    String
  type    account_type
  balance Decimal      @default(0)

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  financialEntries FinancialEntry[]
  transactions     FinancialTransaction[]

  @@index([tenantId])
}

model FinancialCategory {
  id        BigInt   @id @default(autoincrement())
  name      String
  color     String?  @db.VarChar(32)
  icon      String?  @db.VarChar(64)
  active    Boolean  @default(true)
  tenantId  BigInt?
  tenant    tenant?  @relation(fields: [tenantId], references: [id])

  financialEntries FinancialEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum account_type {
  CASHBOX
  BANK
  CREDIT_CARD
}

model FinancialEntry {
  id          BigInt     @id @default(autoincrement())
  type        entry_type
  description String?
  amount      Decimal
  dueDate     DateTime
  paidAt      DateTime?

  workOrderId BigInt?
  workorder   workorder? @relation(fields: [workOrderId], references: [id])

  categoryId BigInt?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  paymentMethodId BigInt?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  accountId BigInt?
  account   FinancialAccount? @relation(fields: [accountId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  transactions FinancialTransaction[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([accountId])
  @@index([paymentMethodId])
  @@index([workOrderId])
  @@index([dueDate])
}

enum entry_type {
  RECEIVABLE
  PAYABLE
}

model FinancialTransaction {
  id        BigInt           @id @default(autoincrement())
  amount    Decimal
  type      transaction_type
  createdAt DateTime         @default(now())

  accountId BigInt
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  entryId BigInt?
  entry   FinancialEntry? @relation(fields: [entryId], references: [id])

  tenantId BigInt?
  tenant   tenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([tenantId])
}

enum transaction_type {
  CREDIT
  DEBIT
}

enum contact_lead_status {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  SPAM
}

enum crm_deal_status {
  OPEN
  WON
  LOST
  CANCELED
}

enum crm_activity_type {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VISIT
  PROPOSAL
  FOLLOW_UP
  OTHER
}

enum crm_task_status {
  OPEN
  DONE
  CANCELED
}
