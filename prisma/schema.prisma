generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model brand {
  id      BigInt    @id @default(autoincrement())
  name    String    @unique(map: "Brand_name_key")
  model   model[]
  vehicle vehicle[]
}

model customer {
  id              BigInt            @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  document        String?
  notes           String?
  customervehicle customervehicle[]
  workorder       workorder[]
}

model customervehicle {
  customerId BigInt
  vehicleId  BigInt
  customer   customer @relation(fields: [customerId], references: [id], map: "CustomerVehicle_customerId_fkey")
  vehicle    vehicle  @relation(fields: [vehicleId], references: [id], map: "CustomerVehicle_vehicleId_fkey")

  @@id([customerId, vehicleId])
  @@index([vehicleId], map: "CustomerVehicle_vehicleId_fkey")
}

model model {
  id      BigInt    @id @default(autoincrement())
  name    String
  brandId BigInt
  brand   brand     @relation(fields: [brandId], references: [id], map: "Model_brandId_fkey")
  vehicle vehicle[]

  @@index([brandId], map: "Model_brandId_fkey")
}

model part {
  id            BigInt          @id @default(autoincrement())
  sku           String?         @unique
  name          String
  description   String? // 👈 novo campo
  price         Decimal         @default(0)
  cost          Decimal         @default(0)
  stockQty      Int             @default(0)
  active        Boolean         @default(true)
  workorderpart workorderpart[]
}

model payment {
  id          BigInt         @id @default(autoincrement())
  workOrderId BigInt
  method      payment_method
  amount      Decimal
  receivedAt  DateTime       @default(now())
  workorder   workorder      @relation(fields: [workOrderId], references: [id], map: "Payment_workOrderId_fkey")

  @@index([workOrderId], map: "Payment_workOrderId_fkey")
}

model servicecatalog {
  id                 BigInt             @id @default(autoincrement())
  name               String
  defaultPrice       Decimal            @default(0.000000000000000000000000000000)
  defaultDurationMin Int?               @default(60)
  cost               Decimal            @default(0.000000000000000000000000000000)
  active             Boolean            @default(true)
  description        String?
  workorderservice   workorderservice[]
}

model user {
  id           BigInt    @id @default(autoincrement())
  name         String
  email        String    @unique(map: "User_email_key")
  passwordHash String
  role         user_role @default(STAFF)
  createdAt    DateTime  @default(now())
}

model vehicle {
  id    BigInt  @id @default(autoincrement())
  plate String  @unique
  year  Int?
  vin   String?
  color String?
  notes String?

  brandId BigInt?
  brand   brand?  @relation(fields: [brandId], references: [id], map: "Vehicle_brandId_fkey")

  // 👇 ESTE AQUI FICA
  modelId BigInt?
  model   model?  @relation(fields: [modelId], references: [id], map: "Vehicle_modelId_fkey")

  // ❌ e GARANTE que NÃO exista nada tipo:
  // model       String?   <-- APAGA ISSO se estiver aí
  // modelText   String?   <-- APAGA ISSO se estiver aí

  customervehicle customervehicle[]
  workorder       workorder[]
}

model workorder {
  id               BigInt             @id @default(autoincrement())
  number           String?            @unique(map: "WorkOrder_number_key")
  customerId       BigInt
  vehicleId        BigInt
  status           workorder_status   @default(PENDING)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  notes            String?
  payment          payment[]
  customer         customer           @relation(fields: [customerId], references: [id], map: "WorkOrder_customerId_fkey")
  vehicle          vehicle            @relation(fields: [vehicleId], references: [id], map: "WorkOrder_vehicleId_fkey")
  workorderpart    workorderpart[]
  workorderservice workorderservice[]

  @@index([customerId], map: "WorkOrder_customerId_fkey")
  @@index([vehicleId], map: "WorkOrder_vehicleId_fkey")
}

model workorderpart {
  id          BigInt    @id @default(autoincrement())
  workOrderId BigInt
  partId      BigInt
  qty         Decimal   @default(1.000000000000000000000000000000)
  unitPrice   Decimal   @default(0.000000000000000000000000000000)
  unitCost    Decimal   @default(0.000000000000000000000000000000)
  discount    Decimal   @default(0.000000000000000000000000000000)
  part        part      @relation(fields: [partId], references: [id], map: "WorkOrderPart_partId_fkey")
  workorder   workorder @relation(fields: [workOrderId], references: [id], map: "WorkOrderPart_workOrderId_fkey")

  @@index([partId], map: "WorkOrderPart_partId_fkey")
  @@index([workOrderId], map: "WorkOrderPart_workOrderId_fkey")
}

model workorderservice {
  id             BigInt         @id @default(autoincrement())
  workOrderId    BigInt
  serviceId      BigInt
  qty            Decimal        @default(1.000000000000000000000000000000)
  unitPrice      Decimal        @default(0.000000000000000000000000000000)
  unitCost       Decimal        @default(0.000000000000000000000000000000)
  discount       Decimal        @default(0.000000000000000000000000000000)
  servicecatalog servicecatalog @relation(fields: [serviceId], references: [id], map: "WorkOrderService_serviceId_fkey")
  workorder      workorder      @relation(fields: [workOrderId], references: [id], map: "WorkOrderService_workOrderId_fkey")

  @@index([serviceId], map: "WorkOrderService_serviceId_fkey")
  @@index([workOrderId], map: "WorkOrderService_workOrderId_fkey")
}

enum payment_method {
  CASH
  CARD
  PIX
  TRANSFER
  OTHER
}

enum workorder_status {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum user_role {
  ADMIN
  STAFF
}
